# AIESEC Forms — environment. Copy to .env.local for development; set the same
# keys in the Vercel project for deployments. Never commit real values.

# --- Database (Supabase Postgres) --------------------------------------------
# Runtime: transaction-mode pooler (port 6543). TLS is enabled in code.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: session-mode pooler (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# Optional: PEM of the database CA to verify the TLS certificate.
DATABASE_CA_CERT=""

# --- AIESEC OAuth (auth.aiesec.org developer application) --------------------
AIESEC_AUTH_URL="https://auth.aiesec.org/oauth"
AIESEC_CLIENT_ID=""
AIESEC_CLIENT_SECRET=""
# Must match a redirect URI registered on the AIESEC application exactly.
AIESEC_REDIRECT_URI="http://localhost:3000/api/auth/callback"
# currentPerson is read with the signed-in user's own token.
GIS_GRAPHQL_URL="https://gis-api.aiesec.org/graphql"

# --- Secrets -----------------------------------------------------------------
# 32+ characters. Seals the session cookie and derives other keys.
SESSION_SECRET=""
# base64 of 32 random bytes (openssl rand -base64 32). Encrypts owner secrets
# and Google tokens at rest. Changing it makes stored secrets unreadable.
ENCRYPTION_KEY=""
# Bearer token Vercel Cron sends to /api/cron/*.
CRON_SECRET=""

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Comma-separated EXPA person ids who can open /admin/activity.
PLATFORM_ADMIN_PERSON_IDS=""
# Only members with a current EXPA position can sign in (true/false).
REQUIRE_CURRENT_POSITION="true"

# --- Google (optional: Sheets and Drive destinations) ------------------------
# OAuth client (Web) with redirect <base>/api/google/callback; Sheets + Drive APIs enabled.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Google Workspace domains whose accounts can be connected (comma-separated).
# Files are created in that account's Drive. "*" allows any Google account.
GOOGLE_ALLOWED_DOMAINS="aiesec.net"
# Optional: Google Picker, so owners can choose an existing Sheet and where the
# AIESEC Forms folder goes. A browser API key (Google Picker API, restricted to
# your site) and the Cloud project number (Dashboard → Project info).
GOOGLE_API_KEY=""
GOOGLE_PROJECT_NUMBER=""

# --- Local development only --------------------------------------------------
# "1" enables /api/auth/dev-login when NODE_ENV=development. Ignored in production.
DEV_LOGIN=""

# --- Cloudflare Turnstile (optional: bot check on form submissions) ----------
# Create a widget at dash.cloudflare.com → Turnstile; add your domains. Both keys
# must be set to turn it on. Test keys: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

{
  "name": "aiesec-forms",
  "version": "0.1.0",
  "private": true,
  "description": "AIESEC Forms: a form builder for every AIESECer. Responses go straight to the owner's destination.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
